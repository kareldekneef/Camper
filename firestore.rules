rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: owner can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sub-collections (categories, masterItems, trips, tripItems)
      match /{subcollection}/{docId} {
        // Owner can always read/write
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Group members can read a trip if they belong to the group it was shared with.
        // Checked against the trip's own groupId — works no matter how many groups
        // either the sharer or the reader belongs to.
        allow read: if request.auth != null
          && subcollection == 'trips'
          && resource.data.groupId is string
          && exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;

        // Group members can read a tripItem if they belong to the group its parent trip was shared with.
        allow read: if request.auth != null
          && subcollection == 'tripItems'
          && resource.data.tripId is string
          && exists(/databases/$(database)/documents/users/$(userId)/trips/$(resource.data.tripId))
          && get(/databases/$(database)/documents/users/$(userId)/trips/$(resource.data.tripId)).data.groupId is string
          && exists(/databases/$(database)/documents/groups/$(get(/databases/$(database)/documents/users/$(userId)/trips/$(resource.data.tripId)).data.groupId))
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(get(/databases/$(database)/documents/users/$(userId)/trips/$(resource.data.tripId)).data.groupId)).data.members;

        // Editors can update tripItems (check permissions on the parent trip)
        allow update: if request.auth != null
          && subcollection == 'tripItems'
          && resource.data.tripId is string
          && exists(/databases/$(database)/documents/users/$(userId)/trips/$(resource.data.tripId))
          && get(/databases/$(database)/documents/users/$(userId)/trips/$(resource.data.tripId)).data.permissions[request.auth.uid] == 'edit';
      }
    }

    // Admin: full read access to all user docs + subcollections, delete subcollection docs,
    // and update top-level user docs (needed to clean up groupIds/activeGroupId when admin
    // removes a member from — or deletes — a group that member can't clean up themselves).
    match /users/{userId} {
      allow read: if request.auth != null
        && request.auth.token.email == 'karel@dekneef.be';
      allow update: if request.auth != null
        && request.auth.token.email == 'karel@dekneef.be';

      match /{subcollection}/{docId} {
        allow read: if request.auth != null
          && request.auth.token.email == 'karel@dekneef.be';
        allow delete: if request.auth != null
          && request.auth.token.email == 'karel@dekneef.be';
      }
    }

    // Invite-code lookup mapping: doc ID *is* the code, so `get` (fetch one
    // known code) is allowed but `list` (enumerate every code) is not —
    // this is what lets join-by-code work without exposing the groups
    // collection to unrestricted scanning.
    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.groupId is string
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid;
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
        && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId == request.auth.uid;
      allow write: if request.auth != null && request.auth.token.email == 'karel@dekneef.be';
    }

    // Groups
    match /groups/{groupId} {
      // Get a single known group (its own members, or admin)
      allow get: if request.auth != null
        && (request.auth.uid in resource.data.members || request.auth.token.email == 'karel@dekneef.be');

      // List/scan the whole collection — admin only (used by the admin panel).
      // Regular joins never list this collection; they resolve via inviteCodes/{code} above.
      allow list: if request.auth != null && request.auth.token.email == 'karel@dekneef.be';

      // Any authenticated user can create a group
      allow create: if request.auth != null;

      // Update: existing members, a new user joining (adding themselves to members), or admin
      allow update: if request.auth != null
        && (
          request.auth.uid in resource.data.members
          || request.auth.uid in request.resource.data.members
          || request.auth.token.email == 'karel@dekneef.be'
        );

      // Delete: existing members, or admin
      allow delete: if request.auth != null
        && (request.auth.uid in resource.data.members || request.auth.token.email == 'karel@dekneef.be');

      // Group sub-collections (categories, masterItems)
      match /{subcollection}/{docId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/groups/$(groupId))
          && (
            request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
            || request.auth.token.email == 'karel@dekneef.be'
          );
        allow write: if request.auth != null
          && exists(/databases/$(database)/documents/groups/$(groupId))
          && (
            request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
            || request.auth.token.email == 'karel@dekneef.be'
          );
      }
    }
  }
}
